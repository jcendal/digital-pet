{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
