{
  "name": "cursor-digital-pet",
  "displayName": "Cursor Digital Pet",
  "description": "Digimon virtual pet for Cursor that evolves with Agent token usage.",
  "version": "0.10.0",
  "publisher": "jcendal",
  "author": "Jorge Cendal",
  "contributors": [
    "Sergio Bugallo"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcendal/digital-pet.git",
    "directory": "packages/cursor-digital-pet"
  },
  "homepage": "https://github.com/jcendal/digital-pet#readme",
  "bugs": {
    "url": "https://github.com/jcendal/digital-pet/issues"
  },
  "keywords": [
    "cursor",
    "digital-pet",
    "virtual-pet",
    "digimon",
    "sidebar",
    "game",
    "games",
    "entertainment",
    "vpet"
  ],
  "icon": "dist/assets/icons/logo.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.13.0",
    "bun": "1.3.5"
  },
  "categories": [
    "Visualization",
    "Game",
    "Pet",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "cursorDigitalPet.sidebar",
          "name": "%contributions.views.explorer.0.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorDigitalPet.spawn",
        "title": "%contributions.commands.0.title%"
      },
      {
        "command": "cursorDigitalPet.freeze",
        "title": "%contributions.commands.1.title%"
      },
      {
        "command": "cursorDigitalPet.unfreeze",
        "title": "%contributions.commands.2.title%"
      },
      {
        "command": "cursorDigitalPet.set",
        "title": "%contributions.commands.3.title%"
      },
      {
        "command": "cursorDigitalPet.dex",
        "title": "%contributions.commands.4.title%"
      },
      {
        "command": "cursorDigitalPet.history",
        "title": "%contributions.commands.5.title%"
      },
      {
        "command": "cursorDigitalPet.installHooks",
        "title": "%contributions.commands.6.title%"
      },
      {
        "command": "cursorDigitalPet.uninstallHooks",
        "title": "%contributions.commands.7.title%"
      },
      {
        "command": "cursorDigitalPet.dev.showMenu",
        "title": "%contributions.commands.8.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cursorDigitalPet.dev.showMenu",
          "when": "cursorDigitalPet.devToolsEnabled"
        }
      ]
    },
    "configuration": {
      "title": "%contributions.configuration.title%",
      "properties": {
        "digital-pet.databasePath": {
          "type": "string",
          "default": "",
          "description": "%contributions.configuration.properties.digital-pet.databasePath.description%"
        },
        "digital-pet.usage.settleDelayMs": {
          "type": "number",
          "default": 4000,
          "description": "%contributions.configuration.properties.digital-pet.usage.settleDelayMs.description%"
        },
        "digital-pet.devTools": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%contributions.configuration.properties.digital-pet.devTools.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --development",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "package": "npx @vscode/vsce package --no-dependencies --baseImagesUrl https://github.com/jcendal/digital-pet/raw/HEAD/packages/cursor-digital-pet",
    "publish:openvsx": "npx ovsx publish *.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@jcendal/digital-pet-animation": "0.2.0-dev.0",
    "@jcendal/digital-pet-core": "0.2.0-dev.0",
    "@jcendal/digital-pet-webviews": "0.1.0-dev.0",
    "sql.js": "^1.12.0",
    "@jcendal/digital-pet-intl": "0.1.0-dev.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "ovsx": "1.2.0",
    "typescript": "5.9.3"
  }
}
