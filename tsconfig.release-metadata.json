    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "types": ["bun", "node"],
    "noEmit": true,
    "rootDir": "scripts",
    "skipLibCheck": true
  },
  "include": [
    "scripts/release-metadata.ts",
