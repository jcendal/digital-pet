{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/**",
      "scripts/**",
      "types/**",
      ".vscode/*.json",
      "package.json",
      "turbo.json",
      "biome.json",
      "tsconfig*.json",
      "!packages/**/dist",
      "!packages/**/dist-static",
      "!packages/**/build",
      "!packages/**/cdk.out",
      "!packages/**/test-results",
      "!packages/**/playwright-report",
      "!packages/cursor-digital-pet/hook-bridge.js",
      "!packages/digital-pet-core/src/data/monster-frame-data.ts",
      "!tests/**/*.jsonc",
      "!.omo/",
      "!node_modules/",
      "!coverage/",
      "!**/generated/"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "recommended": false,
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noVar": "error",
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": [
              "APPDATA",
              "DIGITAL_PET_HOOK_EVENTS_PATH",
              "DIGITAL_PET_HOOK_BRIDGE_PATH",
              "CURSOR_DIGITAL_PET_DEV",
              "DIGITAL_PET_LANGUAGE",
              "OPENCODE_DIGITAL_PET_DEV",
              "DEPLOY_ENV",
              "CDK_OUTDIR",
              "WEB_BUCKET_NAME",
              "GITHUB_ENV",
              "PORT",
              "PROD",
              "DIGITAL_PET_DATABASE_PATH",
              "GITHUB_OUTPUT",
              "GITHUB_EVENT_PATH",
              "TURBO_SCM_BASE",
              "TURBO_SCM_HEAD"
            ]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.browser.js"],
      "javascript": {
        "globals": ["acquireVsCodeApi", "createPanelHelpers", "IntlModule", "getIntlModule", "resolveLocale"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    },
    {
      "includes": [
        "packages/opencode-digital-pet/src/tui/sidebar-card.tsx",
        "packages/opencode-digital-pet/src/tui/digital-pet-dex-dialog.tsx",
        "packages/opencode-digital-pet/src/tui/digital-pet-history-dialog.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}
