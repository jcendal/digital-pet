{
  "name": "@jcendal/digital-pet-workspace",
  "version": "0.0.0",
  "type": "module",
  "author": "Jorge Cendal",
  "contributors": [
    "Sergio Bugallo"
  ],
  "license": "Apache-2.0",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:ci && turbo run test",
    "test:persistence": "turbo run test:persistence",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "imports:fix": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "npm run check:workspace && turbo run check",
    "typecheck": "npm run typecheck:release-metadata && turbo run check",
    "validate": "npm run check && npm run test && npm run test:persistence && npm run test:assets && npm run build",
    "build": "turbo run build",
    "web": "npm run build --workspace @jcendal/web-digital-pet && npm run start --workspace @jcendal/web-digital-pet",
    "pack:opencode": "npm pack --workspace @jcendal/opencode-digital-pet",
    "release:check": "npm run release:check --workspace @jcendal/opencode-digital-pet",
    "release-metadata": "node --experimental-strip-types scripts/release-metadata.ts",
    "typecheck:release-metadata": "tsc -p tsconfig.release-metadata.json --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "backend": "node --experimental-strip-types packages/web-digital-pet-backend/scripts/deploy.ts",
    "test:ci": "bun test ./scripts/tests",
    "test:browser": "turbo run test:browser:run --filter=@jcendal/web-digital-pet",
    "check:workspace": "biome ci . && node scripts/check-workspace-dependencies.mjs && npm run check:assets && npm run typecheck:release-metadata",
    "validate:web": "npm run check:workspace && npm run test:ci && turbo run check test build --filter=@jcendal/web-digital-pet-backend... --concurrency=2",
    "test:browser:visual": "turbo run test:browser:visual --filter=@jcendal/web-digital-pet",
    "test:browser:webkit": "turbo run test:browser:webkit --filter=@jcendal/web-digital-pet",
    "test:assets": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/semver": "7.7.1",
    "esbuild": "0.28.2",
    "semver": "7.7.4",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.11.0",
    "npm": ">=11.5.1",
    "bun": "1.3.5"
  },
  "volta": {
    "node": "24.11.0",
    "bun": "1.3.5"
  }
}
